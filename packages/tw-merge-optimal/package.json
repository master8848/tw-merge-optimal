{
    "name": "tw-merge-optimal",
    "version": "0.2.0",
    "description": "Build-time Tailwind class-merge generator — bundler plugins (Vite, webpack/Rspack/Rsbuild, Bun, Next.js/Turbopack, Babel) around the twm-gen binary",
    "type": "module",
    "main": "./index.mjs",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.mjs"
        },
        "./vite": "./vite.mjs",
        "./webpack": "./webpack.mjs",
        "./rspack": "./rspack.mjs",
        "./rsbuild": "./rsbuild.mjs",
        "./bun": "./bun.mjs",
        "./turbopack": "./turbopack.mjs",
        "./babel": "./babel.mjs",
        "./cli": "./cli.mjs",
        "./generated.mjs": "./generated.mjs"
    },
    "files": [
        "index.mjs",
        "index.d.ts",
        "cli.mjs",
        "vite.mjs",
        "webpack.mjs",
        "rspack.mjs",
        "rsbuild.mjs",
        "bun.mjs",
        "turbopack.mjs",
        "babel.mjs"
    ],
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "keywords": [
        "tailwindcss",
        "tailwind",
        "tw-merge",
        "twmerge",
        "vite",
        "webpack",
        "rspack",
        "rsbuild",
        "bun",
        "turbopack",
        "next.js",
        "babel"
    ],
    "devDependencies": {
        "vite": "^8.2.0"
    }
}
