{
    "name": "tw-merge-optimal-bench",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/tw-merge-optimal"
    ],
    "scripts": {
        "bench:gen": "cargo run -p twm-core --bin bench_gen",
        "bench": "npm run bench:gen && vitest bench --no-watch",
        "build:full": "npm run bench:gen && cp bench/generated/tw-merge-optimal.mjs packages/tw-merge-optimal/full.mjs",
        "test:plugins": "node packages/tw-merge-optimal/test/vite-build.test.mjs",
        "test:full": "node packages/tw-merge-optimal/test/full.test.mjs"
    },
    "devDependencies": {
        "regexp-tree": "^0.1.27",
        "vitest": "^4.1.9"
    }
}
